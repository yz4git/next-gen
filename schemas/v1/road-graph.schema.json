{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/yz4git/next-gen/v0.9.1/schemas/v1/road-graph.schema.json",
  "title": "WorldSeed road graph v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "generator",
    "coordinateSystem",
    "nodes",
    "edges"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "generator": {
      "type": "string"
    },
    "coordinateSystem": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "x",
          "y",
          "z",
          "edgeIds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "z": {
            "type": "number"
          },
          "edgeIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "roadId",
          "from",
          "to",
          "path",
          "lengthMeters",
          "class",
          "widthMeters",
          "surface",
          "oneWay",
          "speedLimitKph"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "roadId": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "path": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/$defs/point"
            }
          },
          "lengthMeters": {
            "type": "number",
            "minimum": 0
          },
          "class": {
            "type": "string"
          },
          "subclass": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "widthMeters": {
            "type": "number",
            "minimum": 0
          },
          "surface": {
            "type": "string"
          },
          "oneWay": {
            "enum": [
              "forward",
              "backward",
              "both"
            ]
          },
          "speedLimitKph": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}